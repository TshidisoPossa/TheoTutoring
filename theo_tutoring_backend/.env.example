DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=theotutoring

# Cloudinary cloud name. Uploaded file URLs (profile photo, certificate,
# ID document) must come from this account.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Firebase project ID used to verify Firebase ID tokens
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase service-account key (Firebase console > Project settings >
# Service accounts > Generate new private key). Lets the backend read and
# write in-app notifications in Firestore. Keep the file OUT of git.
FIREBASE_SERVICE_ACCOUNT_FILE=C:/path/to/firebase-service-account.json
