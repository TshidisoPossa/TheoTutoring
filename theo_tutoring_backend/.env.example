# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored - never commit real passwords.

# Your local MySQL login. Use a MySQL user with access to the theotutoring database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=theotutoring
DB_USER=theo_app
DB_PASSWORD=

# Firebase project the app signs users in with (not secret).
FIREBASE_PROJECT_ID=theotutoring-2e83f

# APP_ENV must be set in the process environment, not this file.
# Demo payments are disabled unless explicitly enabled in development or test.
DEMO_PAYMENTS_ENABLED=false

# Needed for the tutor profile route.
CLOUDINARY_CLOUD_NAME=

# Brevo (https://app.brevo.com) emails the 6-digit sign-up codes.
# API key: Brevo > SMTP & API > API keys. The sender must be verified in
# Brevo > Senders, domains & dedicated IPs. Keep the key out of git.
# Without these, codes are printed in the backend window instead, but only
# while APP_ENV is "development" (set in the process environment).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TheoTutoring
