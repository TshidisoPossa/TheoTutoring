# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored - never commit real passwords.

# Team configuration: the shared Aiven MySQL database.
# Use the Aiven service hostname (not an IP address) and port.
DB_HOST=mysql-87bce02-lelomaluleka11-602b.g.aivencloud.com
DB_PORT=28238
DB_NAME=theotutoring
DB_USER=theotutoring_app_v2
# Ask the project database administrator for this password through a secure
# channel. Never put it in this file, chat messages or commits.
DB_PASSWORD=
# Path to the Aiven MySQL CA certificate (ca.pem from the Aiven console).
# Required for the Aiven configuration above: Aiven's CA is not a system
# trusted certificate. Use the path to your own downloaded copy on your
# machine, for example C:/Users/<you>/aiven/ca.pem. Do not copy another
# developer's path. Keep it outside the repository and never commit it.
DB_SSL_CA=

# Alternative: local MySQL development.
# TLS certificate verification stays on, so a local MySQL with a self-signed
# certificate also needs DB_SSL_CA set to the path of its own CA certificate.
# Replace the DB_ values above with:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=theotutoring
# DB_USER=theo_app
# DB_PASSWORD=<your local MySQL password>
# DB_SSL_CA=

# Local chat testing with the Firestore emulator uses THEO_LOCAL_TEST_DB=1
# and THEO_TEST_DB_* (see lib/local_test_database.dart). Set those in the
# PowerShell session only, never in this file or .env: the backend refuses
# to start database connections if it finds them here.

# Firebase project the app signs users in with (not secret).
FIREBASE_PROJECT_ID=theotutoring-2e83f

# APP_ENV must be set in the process environment, not this file.
# Demo payments are disabled unless explicitly enabled in development or test.
DEMO_PAYMENTS_ENABLED=false

# Needed for the tutor profile route.
CLOUDINARY_CLOUD_NAME=

# Brevo (https://app.brevo.com) emails the 6-digit sign-up codes.
# API key: Brevo > SMTP & API > API keys. The sender must be verified in
# Brevo > Senders, domains & dedicated IPs. Keep the key out of git.
# Without these, codes are printed in the backend window instead, but only
# while APP_ENV is "development" (set in the process environment).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TheoTutoring
